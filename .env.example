# runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=binance-ingestion

# binance source
BINANCE_WS_URL=wss://stream.binance.us:9443/stream
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt
BINANCE_STREAM_TYPE=aggTrade

# reconnect policy
WS_PING_INTERVAL_SECONDS=20
WS_PING_TIMEOUT_SECONDS=20
WS_BACKOFF_BASE_SECONDS=1
WS_BACKOFF_MAX_SECONDS=60

# contracts
SCHEMA_VERSION=1.0.0

# local paths
RAW_OUTPUT_DIR=data/raw
REJECTED_OUTPUT_DIR=data/rejected
CHECKPOINT_DIR=data/checkpoints